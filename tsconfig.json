{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": { "@still-running/health-check": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
